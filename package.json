{
  "name": "nocap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test src/lib/votes.test.ts",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
