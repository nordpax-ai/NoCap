# Copy to .env.local. Do not commit real secrets.

# Application role. The running site connects as this user.
# Used only when it starts with postgres:// or postgresql://.
# file: URLs (including the old preview's DATABASE_URL=file:./preview.db) are ignored.
# On Netlify Database, leave this unset. The app reads getConnectionString() / NETLIFY_DB_URL first.
DATABASE_URL=postgres://nocap_app:nocap_app@localhost:5432/nocap

# Migration and seed role. Not used by the web process locally.
# On Netlify, omit this. db:deploy uses the Netlify Database URL when one is present.
DATABASE_URL_OWNER=postgres://nocap_owner:nocap_owner@localhost:5432/nocap

# Injected by Netlify Database for builds, functions, and the running site.
# getConnectionString() from @netlify/database reads this. A Postgres value here
# is preferred over DATABASE_URL. Non-Postgres values are ignored.
# NETLIFY_DB_URL=

# Legacy Netlify DB (Neon extension) variable. Still accepted when it is a Postgres URL
# and NETLIFY_DB_URL is absent. New databases are no longer created with that extension.
# NETLIFY_DATABASE_URL=

# Public origin used in email links. No trailing slash.
# On Netlify, omit this. Links use URL, then DEPLOY_PRIME_URL.
# The future public domain is nocap-law.com. It is not connected yet.
APP_URL=http://localhost:3000

# Set to 1 on the Netlify demo so the reserved area shows "Demo · example data".
# Also shown automatically when NETLIFY=true.
DEMO_MODE=0

# How dates are shown, and how deadline fields are interpreted.
APP_TIMEZONE=Europe/Rome

# log stores messages in email_log (and ./var/emails locally). Admins read them at /area/admin/outbox.
# smtp sends through the SMTP_* settings below.
EMAIL_PROVIDER=log
EMAIL_FROM="nocap <noreply@nocap-law.com>"

# PLACEHOLDER. Replace with the real Founding Committee address.
FOUNDING_COMMITTEE_EMAIL=founding-committee@nocap-law.com

# PLACEHOLDER. Shown on the public site as the contact address.
CONTACT_EMAIL=contact@nocap-law.com

# local stores files under STORAGE_LOCAL_DIR.
# netlify-blobs uses a Netlify Blobs store named nocap-files (the demo).
# s3 uses the S3_* settings (compatible with Supabase Storage in an EU project).
# STORAGE_PROVIDER is still accepted as an alias of STORAGE_DRIVER.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/storage

# Protects POST /api/jobs/close-votes
CRON_SECRET=change-me

SESSION_DAYS=30

# SMTP (only when EMAIL_PROVIDER=smtp). Provider choice is open.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# S3-compatible storage (only when STORAGE_PROVIDER=s3).
# For Supabase Storage in the EU, use the project's S3 endpoint and region.
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=nocap
S3_ACCESS_KEY=
S3_SECRET_KEY=
