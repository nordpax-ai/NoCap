# Local SQLite. For EU production later, switch provider to postgresql
# and point this at a European-hosted database.
DATABASE_URL="file:./dev.db"

# Required. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public origin used in invite and reset links (no production domain invented).
APP_URL="http://localhost:3000"

# Optional SMTP. If unset, emails are written to the EmailLog table and stdout.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="nocap <noreply@example.com>"

# Optional. Shown only if set — do not invent a committee inbox.
# SECRETARY_EMAIL=

# Optional notify target for membership applications. If unset, no inbox email is sent.
# APPLICATIONS_INBOX=

# Optional. Shown only if set — do not invent a LinkedIn URL.
# LINKEDIN_URL=
